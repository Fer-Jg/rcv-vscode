{
  "name": "rendercv-vscode",
  "displayName": "RenderCV - VScode",
  "description": "RenderCV but in VSCode, for free.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rendercv-vscode-sidebar",
          "title": "RCV - VSCode",
          "icon": "resources/rendercv-sidebar.svg"
        }
      ]
    },
    "views": {
      "rendercv-vscode-sidebar": [
        {
          "id": "rendercv-vscode.mySidebar",
          "name": "RCV - VSCode",
          "type": "webview",
          "icon": "resources/rendercv-sidebar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "rendercv-vscode.installRequirements",
        "title": "Install RenderCV-VSCode Requirements"
      },
      {
        "command": "rendercv-vscode.newCV",
        "title": "Create new CV"
      },
      {
        "command": "rendercv-vscode.previewFileAsCV",
        "title": "Preview file as CV"
      },
      {
        "command": "rendercv-vscode.previewSidebar",
        "title": "Preview CV from Sidebar"
      },
      {
        "command": "rendercv-vscode.duplicateCV",
        "title": "Duplicate CV"
      },
      {
        "command": "rendercv-vscode.sendFeedback",
        "title": "Send Feedback"
      },
      {
        "command": "rendercv-vscode.newGlobal",
        "title": "New",
        "icon": "$(add)"
      },
      {
        "command": "rendercv-vscode.globalSettings",
        "title": "Settings",
        "icon": "$(gear)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rendercv-vscode.previewFileAsCV",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.previewSidebar",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.duplicateCV",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.sendFeedback",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.newGlobal",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.globalSettings",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "rendercv-vscode.previewFileAsCV",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "rendercv-vscode.duplicateCV",
          "when": "webviewId == 'rendercv-vscode.mySidebar' && webviewSection == 'cvItem'",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "rendercv-vscode.newGlobal",
          "when": "view == rendercv-vscode.mySidebar",
          "group": "navigation@1"
        },
        {
          "command": "rendercv-vscode.globalSettings",
          "when": "view == rendercv-vscode.mySidebar",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "RenderCV - VSCode",
      "properties": {
        "rendercv-vscode.autoRenderCooldown": {
          "type": "integer",
          "default": 400,
          "description": "Time in milliseconds to wait after a file change before re-rendering the CV."
        },
        "rendercv-vscode.autoRenderType": {
          "type": "string",
          "enum": [
            "auto", "on-save", "on-click"
          ],
          "enumDescriptions": ["Detect file changes and re-render automatically according to Render Cooldown.", "Only render when the user saves a file.", "Only render when the user clicks the preview button."],
          "default": "auto",
          "description": "Define when you want to re-render the CV."
        },
        "rendercv-vscode.defaultOutputPath": {
          "type": "string",
          "default": "",
          "description": "Default folder where generated CVs are saved."
        },
        "rendercv-vscode.defaultTheme": {
          "type": "string",
          "description": "Default CV theme to use for new CVs.",
          "default": "classic",
          "enum": [
            "classic",
            "moderncv",
            "sb2nov"
          ]
        },
        "rendercv-vscode.renderCVCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to your RenderCV CLI executable. If you have installed RenderCV globally, you can leave this empty. The setup wizard will try to detect it automatically from a global, venv or uv setup."
        },
        "rendercv-vscode.CVYamlFilesFolder": {
          "type": "string",
          "default": "yamls",
          "description": "Path to the folder where your CV YAML files are stored."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "files": [
    "out/**",
    "sidebar/**",
    "package.json"
  ],
  "dependencies": {
    "@vscode/codicons": "^0.0.45"
  }
}
