{
  "version": "0.5.1",
  "name": "rendercv-vscode",
  "publisher": "ferjdev",
  "displayName": "RenderCV - VScode",
  "description": "RenderCV but in VSCode, for free.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fer-Jg/rcv-vscode"
  },
  "bugs": {
    "url": "https://github.com/Fer-Jg/rcv-vscode/issues"
  },
  "license": "None :)",
  "homepage": "https://rcv-vscode.ferj.dev",
  "galleryBanner": {
    "color": "#0b3847",
    "theme": "dark"
  },
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "rendercv", "cv"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rendercv-vscode-sidebar",
          "title": "RCV - VSCode",
          "icon": "resources/rendercv-sidebar.svg"
        }
      ]
    },
    "views": {
      "rendercv-vscode-sidebar": [
        {
          "id": "rendercv-vscode.mainSidebar",
          "name": "RCV - VSCode",
          "type": "webview",
          "icon": "resources/rendercv-sidebar.svg"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "rendercv-vscode.getStarted",
        "title": "Get Started with RenderCV",
        "description": "Create and manage RenderCV resumes from VS Code.",
        "steps": [
          {
            "id": "openSidebar",
            "title": "Open RCV - VSCode",
            "description": "Open the RenderCV sidebar to see your CVs and manage them from VS Code.\n\n[Open RCV - VSCode](command:workbench.view.extension.rendercv-vscode-sidebar)",
            "media": {
              "markdown": "walkthroughs/open-sidebar.md"
            },
            "completionEvents": [
              "onView:rendercv-vscode.mainSidebar"
            ]
          },
          {
            "id": "installCli",
            "title": "Install the RenderCV CLI",
            "description": "Install the RenderCV command-line dependency used to generate your CV outputs.\n\n[What is this?](command:rendercv-vscode.walkthrough.openTutorial)\n[Install now](command:rendercv-vscode.walkthrough.installRequirements)",
            "media": {
              "markdown": "walkthroughs/install-cli.md"
            },
            "completionEvents": [
              "onCommand:rendercv-vscode.walkthrough.installRequirements"
            ]
          },
          {
            "id": "createFirstCv",
            "title": "Create your first CV",
            "description": "Start the CV creation wizard from the walkthrough or from the RCV - VSCode sidebar.\n\n[Create a new CV](command:rendercv-vscode.newCV)",
            "media": {
              "markdown": "walkthroughs/create-first-cv.md"
            },
            "completionEvents": [
              "onContext:rendercv-vscode.walkthrough.createCvStarted"
            ]
          },
          {
            "id": "enjoyUi",
            "title": "Enjoy your RCV UI :)",
            "description": "You are ready to use RenderCV from VS Code.\n\n[Open RCV - VSCode](command:workbench.view.extension.rendercv-vscode-sidebar)",
            "media": {
              "markdown": "walkthroughs/enjoy-ui.md"
            },
            "completionEvents": [
              "onView:rendercv-vscode.mainSidebar"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "rendercv-vscode.installRequirements",
        "title": "Install RenderCV-VSCode Requirements"
      },
      {
        "command": "rendercv-vscode.walkthrough.openTutorial",
        "title": "Open RenderCV Tutorial"
      },
      {
        "command": "rendercv-vscode.walkthrough.installRequirements",
        "title": "Install RenderCV CLI from Walkthrough"
      },
      {
        "command": "rendercv-vscode.newCV",
        "title": "Create new CV"
      },
      {
        "command": "rendercv-vscode.previewFileAsCV",
        "title": "Preview file as CV"
      },
      {
        "command": "rendercv-vscode.previewSidebar",
        "title": "Preview CV from Sidebar"
      },
      {
        "command": "rendercv-vscode.cloneCV",
        "title": "Clone CV"
      },
      {
        "command": "rendercv-vscode.revealOutputPdf",
        "title": "Reveal Output PDF"
      },
      {
        "command": "rendercv-vscode.sendFeedback",
        "title": "Send Feedback"
      },
      {
        "command": "rendercv-vscode.newGlobal",
        "title": "New CV",
        "icon": "$(add)"
      },
      {
        "command": "rendercv-vscode.globalSettings",
        "title": "Settings",
        "icon": "$(gear)"
      },
      {
        "command": "rendercv-vscode.extensionLogs",
        "title": "Output Logs",
        "icon": "$(output)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rendercv-vscode.previewFileAsCV",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.previewSidebar",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.walkthrough.openTutorial",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.walkthrough.installRequirements",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.cloneCV",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.revealOutputPdf",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.sendFeedback",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.newGlobal",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.globalSettings",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.extensionLogs",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "rendercv-vscode.previewFileAsCV",
          "when": "resourceFilename == cv.yaml || resourceFilename == cv.yml",
          "group": "navigation"
        },
        {
          "command": "rendercv-vscode.revealOutputPdf",
          "when": "resourceFilename == cv.yaml || resourceFilename == cv.yml",
          "group": "navigation"
        }
      ],
      "webview/context": [
        {
          "command": "rendercv-vscode.cloneCV",
          "when": "webviewId == 'rendercv-vscode.mainSidebar' && webviewSection == 'cvItem'",
          "group": "inline"
        },
        {
          "command": "rendercv-vscode.revealOutputPdf",
          "when": "webviewId == 'rendercv-vscode.mainSidebar' && webviewSection == 'cvItem'",
          "group": "inline"
        }
      ],
      "view/title": [
        {
          "command": "rendercv-vscode.newGlobal",
          "when": "view == rendercv-vscode.mainSidebar",
          "group": "navigation@1"
        },
        {
          "command": "rendercv-vscode.globalSettings",
          "when": "view == rendercv-vscode.mainSidebar",
          "group": "navigation@2"
        },
        {
          "command": "rendercv-vscode.extensionLogs",
          "when": "view == rendercv-vscode.mainSidebar",
          "group": "navigation@3"
        }
      ]
    },
    "configuration": {
      "title": "RenderCV - VSCode",
      "properties": {
        "rendercv-vscode.autoRenderCooldown": {
          "type": "integer",
          "default": 400,
          "description": "Time in milliseconds to wait after a file change before re-rendering the CV."
        },
        "rendercv-vscode.autoRenderType": {
          "type": "string",
          "enum": [
            "auto",
            "on-save",
            "on-click"
          ],
          "enumDescriptions": [
            "Detect file changes and re-render automatically according to Render Cooldown.",
            "Only render when the user saves a file.",
            "Only render when the user clicks the preview button."
          ],
          "default": "on-save",
          "description": "Define when you want to re-render the CV."
        },
        "rendercv-vscode.defaultOutputPath": {
          "type": "string",
          "default": "",
          "description": "Default folder where generated CVs are saved."
        },
        "rendercv-vscode.defaultTheme": {
          "type": "string",
          "description": "Default CV theme to use for new CVs.",
          "default": "classic",
          "enum": [
            "classic",
            "moderncv",
            "sb2nov"
          ]
        },
        "rendercv-vscode.renderCVCliPath": {
          "type": "string",
          "default": "",
          "description": "Path to your RenderCV CLI executable. If you have installed RenderCV globally, you can leave this empty. The setup wizard will try to detect it automatically from a global, venv or uv setup."
        },
        "rendercv-vscode.CVYamlFilesFolder": {
          "type": "string",
          "default": "yamls",
          "description": "Path to the folder where your CV YAML files are stored."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "files": [
    "out/**",
    "cv-creation/**",
    "node_modules/**",
    "sidebar/**",
    "media/**",
    "walkthroughs/**",
    "resources/**",
    "package.json",
    "LICENSE.md",
    "SUPPORT.md",
    "CHANGELOG.md"
  ],
  "dependencies": {
    "@vscode/codicons": "^0.0.45",
    "yaml": "^2.9.0"
  }
}