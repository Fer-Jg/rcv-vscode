{
  "name": "rendercv-vscode",
  "displayName": "RenderCV - VScode",
  "description": "RenderCV but in VSCode, for free.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rendercv-vscode-sidebar",
          "title": "RCV - VSCode",
          "icon": "resources/rendercv-sidebar.svg"
        }
      ]
    },
    "views": {
      "rendercv-vscode-sidebar": [
        {
          "id": "rendercv-vscode.mySidebar",
          "name": "RCV - VSCode",
          "type": "webview",
          "icon": "resources/rendercv-sidebar.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "rendercv-vscode.installRequirements",
        "title": "Install RenderCV-VSCode Requirements"
      },
      {
        "command": "rendercv-vscode.newCV",
        "title": "Create new CV"
      },
      {
        "command": "rendercv-vscode.previewFileAsCV",
        "title": "Preview file as CV"
      },
      {
        "command": "rendercv-vscode.previewSidebar",
        "title": "Preview CV from Sidebar"
      },
      {
        "command": "rendercv-vscode.sendFeedback",
        "title": "Send Feedback"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "rendercv-vscode.previewFileAsCV",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.previewSidebar",
          "when": "false"
        },
        {
          "command": "rendercv-vscode.sendFeedback",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "rendercv-vscode.previewFileAsCV",
          "when": "resourceExtname == .yaml || resourceExtname == .yml",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "files": [
    "out/**",
    "sidebar/**",
    "package.json"
  ]
}